              "title": {
                "en": "Docked"
              }
            },
            {
              "id": "charging",
              "title": {
                "en": "Charging"
              }
            }
          ]
        }
      },
      "images": {
        "small": "/drivers/midea-vacuum/assets/images/small.png",
        "large": "/drivers/midea-vacuum/assets/images/large.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "MSmartHome Login"
