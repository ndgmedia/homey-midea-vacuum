      "uiComponent": "picker",
      "getable": true,
      "setable": true,
      "values": [
        {
          "id": "quiet",
          "title": {
            "en": "Quiet"
          }
        },
        {
          "id": "normal",
          "title": {
            "en": "Normal"
          }
        },
        {
          "id": "strong",
          "title": {
            "en": "Strong"
          }
        }
      ]
    },
    "measure_cleaning_area": {
      "type": "number",
